# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
coverage/

# Production (built by `npm run build`; npm ships it via prepare/prepublishOnly)
dist/
*.tgz

# Build output must never sit next to the sources
src/**/*.js
src/**/*.d.ts
src/**/*.map

# Temp bundles written while loading accessnexus.schema.ts / accessnexus.config.ts
.accessnexus-temp-*

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo

# TypeScript
tsconfig.tsbuildinfo

# Compiled single-file binaries (bun --compile) — build artifacts, not source
bin/

# Private notes and vendored references — kept locally, never committed
docs/STRATEGY.md
docs/FIREBASE_PLAN.md
docs/supabase-postgres-best-practices/
