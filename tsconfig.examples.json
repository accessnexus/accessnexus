{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node"
    ],
    "paths": {
      "accessnexus": [
        "./src/index.ts"
      ],
      "accessnexus/testing": [
        "./src/testing/index.ts"
      ],
      "accessnexus/adapters/supabase": [
        "./src/adapters/supabase/index.ts"
      ]
    }
  },
  "include": [
    "examples/**/*.ts",
    "accessnexus.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
